{
  "name": "wp-html-to-docx",
  "version": "0.2.4",
  "description": "Convert HTML to DOCX, works in browser and Node.js.",
  "homepage": "https://github.com/oldj/wp-html-to-docx#readme",
  "bugs": {
    "url": "https://github.com/oldj/wp-html-to-docx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldj/wp-html-to-docx.git"
  },
  "license": "MIT",
  "author": "oldj",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch examples/demo.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "version:sync": "node scripts/sync-version.mjs",
    "version": "npm run version:sync && git add src/version.ts",
    "build": "npm run clean && npm run version:sync && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "parse5": "^8.0.1"
  },
  "peerDependencies": {
    "mathml2omml": "^0.5.0"
  },
  "peerDependenciesMeta": {
    "mathml2omml": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "^0.8.2",
    "jsdom": "^29.0.2",
    "mathml2omml": "^0.5.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  }
}
